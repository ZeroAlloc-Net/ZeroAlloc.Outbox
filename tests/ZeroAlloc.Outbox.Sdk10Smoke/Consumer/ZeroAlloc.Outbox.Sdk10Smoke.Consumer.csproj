<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of every packed ZeroAlloc.Outbox package with the oldest supported .NET SDK
    band, 10.0.1xx, whose compiler is Roslyn 5.0. The ZeroAlloc.Outbox package bundles the
    generator in analyzers/dotnet/cs, and each adapter package brings the generators of its own
    dependencies: ZeroAlloc.Outbox.Orm pulls in AdoNet.Async.Adapters and, through it,
    ZeroAlloc.AsyncEvents. The consumer references all of them, because a package it leaves out
    is a graph it never checks.
    A generator built against a newer Roslyn than the compiler that loads it is skipped with
    CS9057, and the build then fails because the generated code is missing.

    CS9057 is an error here as well. ZeroAlloc.ValueObjects 2.4.3, ZeroAlloc.Resilience 3.6.0,
    ZeroAlloc.StateMachine 1.8.2, ZeroAlloc.Serialisation 2.11.2 and the transitive
    ZeroAlloc.Collections 1.3.2 also ship generators built against Roslyn 5.0, so no package in
    this build may be skipped.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      unset v; r=$(od -An -N4 -tx4 /dev/urandom | tr -d " ") && [ -n "$r" ] && v=9.9.9-local.sha$(git rev-parse HEAD | cut -c1-7).$(date +%s).r$r
      for p in src/ZeroAlloc.Outbox*/ZeroAlloc.Outbox*.csproj; do case $p in *.Generator.csproj) continue ;; esac
        dotnet pack $p -c Release -o artifacts -p:Version=${v:?no random suffix}; done
      cd tests/ZeroAlloc.Outbox.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocOutboxVersion=${v:?no random suffix}
    Each step stops when the random suffix cannot be generated; give each
    concurrent run its own worktree, because runs in one checkout share obj and bin.
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocOutboxVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocOutboxVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocOutboxVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Outbox" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="ZeroAlloc.Outbox.InMemory" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="ZeroAlloc.Outbox.Orm" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="ZeroAlloc.Outbox.EfCore" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="ZeroAlloc.Outbox.Mediator" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="ZeroAlloc.Outbox.Resilience" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="ZeroAlloc.Outbox.Telemetry" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="ZeroAlloc.Outbox.Dashboard" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="ZeroAlloc.Outbox.Dashboard.Blazor" Version="[$(ZeroAllocOutboxVersion)]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>
</Project>
