<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- src stays on the ZeroAlloc.Mediator 5.1.5 floor it ships with; the tests run against
         the newest major so a consumer who upgrades Mediator is covered. -->
    <PackageReference Include="ZeroAlloc.Mediator" Version="7.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <!-- MemoryPackStructMessage: a struct format that reads without allocating, for the read-path gate. -->
    <PackageReference Include="MemoryPack" Version="1.22.0" />
    <PackageReference Include="ZeroAlloc.TestHelpers" Version="1.10.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>contentfiles;build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q: pin the native SQLite binary (3.50.3) pulled
         transitively by Microsoft.Data.Sqlite / EF Core Sqlite (2.1.x is vulnerable). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <!-- Server integration fixtures: the EF Core claim's re-checked conditional update can
         only be proven exclusive against real engines. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.17.0" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox\ZeroAlloc.Outbox.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox.InMemory\ZeroAlloc.Outbox.InMemory.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox.EfCore\ZeroAlloc.Outbox.EfCore.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox.Dashboard\ZeroAlloc.Outbox.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox.Dashboard.Blazor\ZeroAlloc.Outbox.Dashboard.Blazor.csproj" />
    <!-- The enqueue allocation tests measure the writer the generator emits, not a stand-in. -->
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox.Generator\ZeroAlloc.Outbox.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- CVE-2026-84008 / GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7: EF Core SqlServer 10.0.12 pulls
         Microsoft.Data.SqlClient 6.1.6 and so the vulnerable System.Security.Cryptography.Pkcs 9.0.11.
         The latest EF Core 10.0.13 takes SqlClient 6.1.7, which still depends on Pkcs 9.0.11. Remove
         this pin once Microsoft.EntityFrameworkCore.SqlServer depends on a patched Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <!-- One container per test class, a database per test; shared with ZeroAlloc.Outbox.Orm.Tests. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
