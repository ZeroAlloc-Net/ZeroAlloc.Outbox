<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- src stays on the ZeroAlloc.Mediator 5.1.5 floor it ships with; the tests run against
         the newest major so a consumer who upgrades Mediator is covered. -->
    <PackageReference Include="ZeroAlloc.Mediator" Version="6.6.2" />
    <PackageReference Include="ZeroAlloc.TestHelpers" Version="1.7.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>contentfiles;build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- CVE-2025-6965: override the native SQLite binary, matching the repo root. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="AdoNet.Async.Adapters" Version="1.5.2" />
    <!-- SQL Server integration fixture: the OFFSET/FETCH spelling and the DDL
         are only provably correct against a real engine. -->
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- CVE-2026-84008 / GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7: Microsoft.Data.SqlClient 7.1.1,
         the latest release, pulls the vulnerable System.Security.Cryptography.Pkcs 9.0.18. Remove
         this pin once Microsoft.Data.SqlClient depends on a patched Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- PostgreSQL integration fixture: FOR UPDATE SKIP LOCKED can only be proven
         exclusive against a real engine. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- One container per test class, a database per test; shared with ZeroAlloc.Outbox.Tests. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox\ZeroAlloc.Outbox.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox.Orm\ZeroAlloc.Outbox.Orm.csproj" />
    <!-- The registration tests put the EF Core store next to the ORM store. -->
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox.EfCore\ZeroAlloc.Outbox.EfCore.csproj" />
  </ItemGroup>
</Project>
