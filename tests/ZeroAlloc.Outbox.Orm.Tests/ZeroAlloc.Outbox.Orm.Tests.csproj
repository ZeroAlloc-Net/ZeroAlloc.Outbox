<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- CVE-2025-6965: override the native SQLite binary, matching the repo root. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="AdoNet.Async.Adapters" Version="1.4.1" />
    <!-- SQL Server integration fixture: the OFFSET/FETCH spelling and the DDL
         are only provably correct against a real engine. -->
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <!-- PostgreSQL integration fixture: FOR UPDATE SKIP LOCKED can only be proven
         exclusive against a real engine. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- One container per test class, a database per test; shared with ZeroAlloc.Outbox.Tests. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox\ZeroAlloc.Outbox.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Outbox.Orm\ZeroAlloc.Outbox.Orm.csproj" />
  </ItemGroup>
</Project>
