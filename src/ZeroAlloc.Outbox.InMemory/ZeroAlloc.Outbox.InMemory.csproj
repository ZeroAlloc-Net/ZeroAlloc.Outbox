<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Outbox.InMemory</PackageId>
    <Description>In-memory store adapter for ZeroAlloc.Outbox (testing).</Description>
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Outbox\ZeroAlloc.Outbox.csproj" />
    <PackageReference Include="ZeroAlloc.Collections" Version="1.1.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one-store-per-container check every store adapter applies; linked, not public API. -->
    <Compile Include="..\Shared\OutboxStoreRegistration.cs" Link="OutboxStoreRegistration.cs" />
  </ItemGroup>
</Project>
