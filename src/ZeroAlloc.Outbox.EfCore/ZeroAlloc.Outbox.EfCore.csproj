<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Outbox.EfCore</PackageId>
    <Description>EF Core store adapter for ZeroAlloc.Outbox.</Description>
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- ZeroAlloc.ValueObjects.EfCore 1.3.1 requires EF Core 9.0.0+ across all TFMs.
         EF Core 9.0.x supports net8.0 (LTS), so we unify on 9.0.4 for all targets. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.19" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Outbox\ZeroAlloc.Outbox.csproj" />
    <PackageReference Include="ZeroAlloc.ValueObjects.EfCore" Version="1.3.1" />
  </ItemGroup>
</Project>
