<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>ZeroAlloc.Outbox.EfCore</PackageId>
    <Description>EF Core store adapter for ZeroAlloc.Outbox.</Description>
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <!-- Both targets compile against EF Core 10. EF Core 10 changed the ExecuteUpdateAsync setter
       parameter from SetPropertyCalls<T> to UpdateSettersBuilder<T>, so a store built against
       EF Core 9 throws TypeLoadException on the first claim once the app resolves EF Core 10.
       ZeroAlloc.ValueObjects.EfCore ships net8.0 and net9.0 only, with an EF Core 9 floor, so it
       takes its net9.0 build and runs on the EF Core 10 referenced here.
       net11.0 stays on EF Core 10 as well: Npgsql.EntityFrameworkCore.PostgreSQL has no stable
       EF Core 11 release yet and its 10.x line caps Microsoft.EntityFrameworkCore below 11. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Outbox\ZeroAlloc.Outbox.csproj" />
    <PackageReference Include="ZeroAlloc.ValueObjects.EfCore" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one-store-per-container check every store adapter applies; linked, not public API. -->
    <Compile Include="..\Shared\OutboxStoreRegistration.cs" Link="OutboxStoreRegistration.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
