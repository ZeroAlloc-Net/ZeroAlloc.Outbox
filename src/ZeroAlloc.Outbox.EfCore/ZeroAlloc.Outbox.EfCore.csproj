<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Outbox.EfCore</PackageId>
    <Description>EF Core store adapter for ZeroAlloc.Outbox.</Description>
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <!-- Each target compiles against the EF Core line it runs on. EF Core 10 changed the
       ExecuteUpdateAsync setter parameter from SetPropertyCalls<T> to UpdateSettersBuilder<T>,
       so a net10.0 build against EF Core 9 throws TypeLoadException on the first claim once the
       app resolves EF Core 10. net8.0 and net9.0 stay on EF Core 9, the newest line they support.
       ZeroAlloc.ValueObjects.EfCore ships net8.0 and net9.0 only, with an EF Core 9 floor, so on
       net10.0 it takes its net9.0 build and runs on the EF Core 10 referenced here. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Outbox\ZeroAlloc.Outbox.csproj" />
    <PackageReference Include="ZeroAlloc.ValueObjects.EfCore" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one-store-per-container check every store adapter applies; linked, not public API. -->
    <Compile Include="..\Shared\OutboxStoreRegistration.cs" Link="OutboxStoreRegistration.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
