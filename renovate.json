{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>ZeroAlloc-Net/.github"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Skip EF Core major bumps: the store adapter compiles both net10.0 and net11.0 against EF Core 10, and the Npgsql 10.x provider caps EF Core below 11. Revisit with the next framework change.",
      "matchPackagePrefixes": [
        "Microsoft.EntityFrameworkCore"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Group Roslyn analyzer packages",
      "matchPackageNames": [
        "Meziantou.Analyzer",
        "Roslynator.Analyzers"
      ],
      "groupName": "Roslyn analyzers"
    },
    {
      "description": "Group xunit packages",
      "matchPackagePrefixes": [
        "xunit"
      ],
      "groupName": "xunit"
    },
    {
      "description": "Group Microsoft.Extensions packages",
      "matchPackagePrefixes": [
        "Microsoft.Extensions."
      ],
      "groupName": "Microsoft.Extensions"
    },
    {
      "description": "Group Microsoft.CodeAnalysis packages",
      "matchPackagePrefixes": [
        "Microsoft.CodeAnalysis."
      ],
      "groupName": "Microsoft.CodeAnalysis"
    },
    {
      "description": "Group Entity Framework Core packages",
      "matchPackagePrefixes": [
        "Microsoft.EntityFrameworkCore"
      ],
      "groupName": "Entity Framework Core"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
